# Môi trường ảo là công cụ chạy, không phải mã nguồn.
.venv/
venv/

# File Python và kết quả kiểm thử sinh tự động.
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/

# Cấu hình riêng; vẫn giữ file mẫu để chia sẻ cách cấu hình.
.env
.env.*
!.env.example

# Log và dữ liệu SQLite sinh lúc chạy ở các giai đoạn sau.
*.log
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
runtime/*.bak
