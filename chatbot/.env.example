# Đây là mẫu cấu hình, không chứa bí mật hoặc dữ liệu cá nhân.
# Chương trình đọc biến môi trường, chưa tự nạp file .env.
# Xem README.md để đặt các biến này trong PowerShell.
DATA_SOURCE=local_demo
ORDER_PROVIDER=local_demo
DATABASE_PATH=runtime/chatbot.sqlite3
TIMEZONE=Asia/Ho_Chi_Minh
# Mặc định dùng Qwen qua Ollama. Chỉ chọn rule khi chủ động thử không có AI.
CHAT_MODE=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Để rỗng: chọn Qwen local đã có qua /api/tags, không tải model.
# Máy đã kiểm tra có qwen3.5:4b; có thể đặt đúng tên đó, không tự đổi model.
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=60
CONTEXT_MAX_TURNS=6
# local_demo đọc policies từ cùng SQLite; empty/sample là chế độ học cũ.
KNOWLEDGE_MODE=local_demo
KNOWLEDGE_PATH=data/sample_policies.json
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.15
# Tương thích cấu hình cũ: CATALOG_MODE và CHATBOT_DB_PATH vẫn được đọc
# khi DATA_SOURCE/DATABASE_PATH chưa có. Không đặt hai tên trái nhau.
