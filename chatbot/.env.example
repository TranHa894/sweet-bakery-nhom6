# Mẫu cấu hình: chatbot tự đọc .env trong cùng thư mục. Biến môi trường ưu tiên.
# Đọc danh mục mẫu từ website nhóm, không ghi file/backend bên ngoài.
DATA_SOURCE=group_files
GROUP_CATALOG_PATH=../static/products.json
# unsupported: không gửi đơn kinh doanh; yêu cầu chờ tư vấn vẫn lưu SQLite chatbot.
ORDER_PROVIDER=unsupported
DATABASE_PATH=runtime/chatbot.sqlite3
TIMEZONE=Asia/Ho_Chi_Minh
CHAT_MODE=ollama
# Ollama local là chế độ mặc định; không tự chuyển sang rule khi lỗi.
OLLAMA_BASE_URL=http://localhost:11434
# Tên Qwen đã kiểm tra bằng ollama list; không tải model hoặc gọi cloud.
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=60
CONTEXT_MAX_TURNS=6
# Menu nhóm chưa có chính sách; không dùng tài liệu demo như chính sách thật.
KNOWLEDGE_MODE=empty
KNOWLEDGE_PATH=data/sample_policies.json
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.15
CHAT_DEBUG=false
RETRIEVAL_MODE=keyword
EMBEDDING_MODEL=
VECTOR_INDEX_PATH=runtime/policy_vectors.json
VECTOR_MIN_SCORE=0.5
# Chế độ cũ: DATA_SOURCE=local_demo / ORDER_PROVIDER=local_demo /
# KNOWLEDGE_MODE=local_demo để dùng SQLite demo 25 bánh.
# CATALOG_MODE và CHATBOT_DB_PATH còn tương thích khi tên cấu hình mới chưa có.
# backend chưa hỗ trợ tạo đơn qua Flask của nhóm.
